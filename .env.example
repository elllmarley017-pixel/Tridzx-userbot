# Telegram Bot API token dari @BotFather (JANGAN commit file .env)
# Token ini HANYA untuk Bot API (Inline Mode, menu bot) dan tidak bisa
# dipakai untuk login sesi userbot MTProto.
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opsional
# USERBOT_OWNER_ID=123456789
# USERBOT_BRIDGE_BOT=hybrixhanbot
# INLINE_ENABLED=1
# INLINE_MAX_RESULTS=25
# INLINE_CACHE_TIME=0
# TELEGRAM_API_BASE=https://api.telegram.org
# USERBOT_RICH_TRANSPORT=userbot
